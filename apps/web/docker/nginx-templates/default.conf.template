server {
    listen       ${ELEMENT_WEB_PORT};
    listen  [::]:${ELEMENT_WEB_PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # Serve the precompressed .gz siblings emitted by the webpack build
    # (CompressionPlugin) instead of the uncompressed originals.
    gzip_static on;

    # Set no-cache for the version, config, i18n, and index.html
    # so that browsers always check for a new copy of Element Web.
    # NB http://your-domain/ and http://your-domain/? are also covered by this

    location = /index.html {
        # A short freshness window: repeat visits within a minute skip the
        # revalidation round trip, while updates still roll out promptly.
        add_header Cache-Control "public, max-age=60, must-revalidate";
    }
    # Bundles are content-hashed (webapp/bundles/<hash>/...), so they can be
    # cached forever and never need revalidation.
    location /bundles/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /version {
        add_header Cache-Control "no-cache";
    }
    location /i18n/ {
        add_header Cache-Control "no-cache";
    }

    # covers config.json and config.hostname.json requests as it is prefix.
    location /config {
        root /tmp/element-web-config;
        add_header Cache-Control "no-cache";
    }
    location /modules {
        alias /modules;
    }
    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;
}

